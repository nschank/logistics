#!/usr/bin/env bash
# Full gcloud logout + single fresh login (user credentials and ADC).
#
# `gcloud auth login` (even with --force) reuses the existing reauth session,
# so the org session-length timer never resets. Revoking everything first
# forces a brand-new session, so one browser trip covers the whole day.
set -euo pipefail

# Revoke user accounts one by one. Skip service accounts: GCE metadata-server
# credentials can't be revoked (and have no reauth timer anyway).
for account in $(gcloud auth list --format='value(account)'); do
  case "$account" in
    *.gserviceaccount.com) ;;
    *) gcloud auth revoke "$account" --quiet || true ;;
  esac
done

# By the time this runs the ADC token is usually already expired, so
# server-side revocation fails with "Token is not revocable" — ignore it and
# delete the local ADC file directly.
gcloud auth application-default revoke --quiet 2>/dev/null || true
rm -f "${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json"

exec gcloud auth login --update-adc
